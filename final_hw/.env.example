# LLM Provider Configuration
# ---------------------------------------------------------------------------
# Which provider implementation to use
LLM_PROVIDER=groq

# API key for the selected provider. NEVER commit a real key to source control.
LLM_API_KEY=your-api-key-here

# Model identifier passed to the provider.
LLM_MODEL=llama-3.3-70b-versatile

# Max tokens for a single LLM completion.
LLM_MAX_TOKENS=2048

# ---------------------------------------------------------------------------
# Agent configuration
# ---------------------------------------------------------------------------
# Hard safety cap on the number of reasoning/tool-call steps per question.
MAX_AGENT_STEPS=10

# ---------------------------------------------------------------------------
# Application configuration
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Directory where uploaded datasets are stored (session-scoped subfolders).
DATA_STORAGE_DIR=./data/uploads

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=50

# Maximum number of rows accepted for a single dataset (safety limit for
# in-memory analysis / SHAP / model training in this portfolio project).
MAX_DATASET_ROWS=200000

# FastAPI backend URL, used by the Streamlit frontend.
BACKEND_URL=http://localhost:8000
